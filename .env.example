# Runtime
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI providers: keep server-side; never prefix secret keys with NEXT_PUBLIC_
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_GATEWAY_API_KEY=
AI_MODEL_MULTIMODAL=
AI_MODEL_REASONING=
AI_MODEL_FAST=
AI_MODEL_REVIEWER=
# Embedding model for the RAG pipeline. Its output width must match
# document_embeddings.embedding vector(1536) — see migration
# 20261002000009_rag_provenance.sql. Changing it requires a migration.
AI_MODEL_EMBEDDING=

# Observability (optional until Sentry is configured)
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Database (PostgreSQL / Supabase) — required for database migrations and runtime
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/merchant_brain
# Supabase project URL and anon key (for client-side Supabase integration)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Auth (future integration)
AUTH_SECRET=

# Evaluation tooling (only for local/CI eval runs)
PROMPTFOO_API_KEY=
PROMPTFOO_MODEL=
