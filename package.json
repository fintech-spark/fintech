{
  "name": "merchant-brain",
  "version": "0.1.0",
  "description": "Merchant Brain development foundation",
  "scripts": {
    "test": "vitest run",
    "eval": "vitest run --config evals/vitest.eval.config.ts",
    "eval:watch": "vitest --config evals/vitest.eval.config.ts",
    "eval:live": "vitest run --config evals/vitest.live.config.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "security:audit": "npm audit --audit-level=high --omit=dev",
    "db:migrate": "node scripts/migrate.mjs up",
    "db:migrate:status": "node scripts/migrate.mjs status",
    "db:seed": "node scripts/seed.mjs",
    "test:db": "vitest run tests/database-schema.test.ts tests/database-validation.test.ts",
    "test:db:live": "vitest run --config vitest.live.config.ts",
    "verify:setup": "npm run lint && npm run typecheck && npm test && npm run build",
    "skills:validate": "node .agents/tools/validate-skills.mjs",
    "skills:index": "./.agents/tools/skills-index.sh"
  },
  "type": "module",
  "private": "true",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.71",
    "@ai-sdk/google": "^4.0.87",
    "@ai-sdk/openai": "^4.0.83",
    "@hookform/resolvers": "^5.9.1",
    "@supabase/supabase-js": "^2.117.2",
    "ai": "^7.0.126",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.49.0",
    "next": "^16.3.8",
    "pg": "^8.23.1",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@shadcn/lint": "^0.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "postcss": "^8.5.28",
    "shadcn": "^4.21.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "braces": "^3.0.3"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "fsevents@2.3.3": true
  }
}
