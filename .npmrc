engine-strict=true
fund=true
audit=true

# Explicitly allow the only legitimate build-script dependency so Vercel's
# stricter install policy runs it deterministically. unrs-resolver's
# postinstall selects the prebuilt native binding used by
# eslint-import-resolver-typescript (via eslint-config-next). Strict
# allow-scripts stays off, so this is an allow-list, not a blanket allow.
allow-scripts=unrs-resolver
